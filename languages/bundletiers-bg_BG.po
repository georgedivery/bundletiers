#. Plugin Name of the plugin
#: bundletiers.php
msgid "BundleTiers – Bundle Discounts for WooCommerce"
msgstr "BundleTiers – Bundle Discounts for WooCommerce"

#. Description of the plugin
#: bundletiers.php
msgid ""
"Quantity-tier bundle discounts (1 / 2 / 3 pcs) for WooCommerce products, "
"with variations counted together."
msgstr ""
"Отстъпки за комплекти по количество (1 / 2 / 3 броя) за продукти на "
"WooCommerce, с обща сметка на вариациите."

#. Author of the plugin
#: bundletiers.php
msgid "Webbeb"
msgstr "Webbeb"

#. Author URI of the plugin
#: bundletiers.php
msgid "https://webbeb.com"
msgstr "https://webbeb.com"

#: includes/class-plugin.php:71
msgid "BundleTiers requires WooCommerce to be installed and active."
msgstr "BundleTiers изисква WooCommerce да е инсталиран и активен."

#: includes/class-product-tab.php:37 includes/class-settings-page.php:22
msgid "BundleTiers"
msgstr "BundleTiers"

#: includes/class-product-tab.php:66
msgid "Enable bundles"
msgstr "Включи комплектите"

#: includes/class-product-tab.php:67
msgid "Offer quantity bundles with a discount for this product"
msgstr "Предлагай комплекти по количество с отстъпка за този продукт"

#: includes/class-product-tab.php:74 includes/class-settings-page.php:43
msgid "Tiers"
msgstr "Нива"

#: includes/class-product-tab.php:77
msgid "Global tiers (WooCommerce → Settings → BundleTiers)"
msgstr "Общи нива (WooCommerce → Настройки → BundleTiers)"

#: includes/class-product-tab.php:78
msgid "Custom tiers for this product"
msgstr "Собствени нива за този продукт"

#: includes/class-product-tab.php:113
msgid "BundleTiers: custom tiers were empty, so global tiers are used."
msgstr "BundleTiers: собствените нива бяха празни, затова се използват общите."

#: includes/class-settings-page.php:37
msgid "Default tiers"
msgstr "Общи нива"

#: includes/class-settings-page.php:39
msgid ""
"Used by every product that has BundleTiers switched on and set to \"Global "
"tiers\"."
msgstr ""
"Използват се от всеки продукт с включен BundleTiers и избрани „Общи нива“."

#: includes/class-settings-page.php:48
msgid "Count variations together"
msgstr "Брой вариациите заедно"

#: includes/class-settings-page.php:49
msgid ""
"Add up the quantities of all variations of a product to find the tier (1 × S "
"+ 2 × M = pack of 3)."
msgstr ""
"Събира количествата на всички вариации на продукта, за да определи нивото (1 "
"× S + 2 × M = комплект от 3)."

#: includes/class-settings-page.php:55
msgid "Coupons"
msgstr "Купони"

#: includes/class-settings-page.php:56
msgid "Do not allow coupons on products that get a bundle discount"
msgstr "Не позволявай купони за продукти с отстъпка за комплект"

#: includes/class-settings-page.php:67
msgid "Appearance"
msgstr "Външен вид"

#: includes/class-settings-page.php:69
